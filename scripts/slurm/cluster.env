# Cluster-specific defaults for the Compute Canada / Alliance scripts in this directory.
# Every value can be overridden from the environment, e.g.  VENV=~/envs/x scripts/slurm/submit.sh ...
# (#SBATCH headers in run_*.sh repeat the account / mail values because SLURM reads them before bash runs;
#  submit.sh passes the values below on the command line, which takes precedence over the headers.)
export SLURM_ACCOUNT=${SLURM_ACCOUNT:-aip-machado}
export MAIL_USER=${MAIL_USER:-mamoham3@ualberta.ca}
export MAIL_TYPE=${MAIL_TYPE:-ALL}

export STDENV=${STDENV:-StdEnv/2023}
export PY_MODULE=${PY_MODULE:-python/3.11.5}

# project space (home has a small quota); $USER is `mayman` on the cluster
export PROJECT_ROOT=${PROJECT_ROOT:-$HOME/projects/aip-machado/$USER}

# PROJECT_DIR = the repository these scripts live in, wherever it was cloned
# (on the cluster: $PROJECT_ROOT/MARL/Understanding-Empathy-and-Cooperation-in-Multi-Agent-Reinforcement-Learning)
export PROJECT_DIR=${PROJECT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}

export VENV=${VENV:-$PROJECT_ROOT/MARL/envs/empathy}
export RUN_ROOT=${RUN_ROOT:-${SCRATCH:-$PROJECT_ROOT}/empathy_runs}
